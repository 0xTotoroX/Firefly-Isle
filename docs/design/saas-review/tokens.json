{
  "$description": "病历管理工具独立设计系统，深石板灰与科技蓝。评审稿 1.0；不连接业务服务。",
  "version": "1.0.0",
  "primitive": {
    "gray": {
      "100": "#F3F6FA",
      "200": "#DAE1E9",
      "300": "#B6C2D2",
      "400": "#97A7BD",
      "500": "#64748B",
      "600": "#43536B",
      "700": "#2B3748",
      "800": "#1B2430",
      "900": "#121820"
    },
    "blue": {
      "100": "#E7F0FF",
      "200": "#C6DCFF",
      "300": "#96BDFF",
      "400": "#6BA3FF",
      "500": "#377DFF",
      "600": "#2563EB",
      "700": "#1D4ED8",
      "800": "#1E40AF",
      "900": "#172E68"
    },
    "white": "#FFFFFF",
    "canvas": "#0B1119"
  },
  "semantic": {
    "background": {
      "canvas": "#0B1119",
      "page": "#121820",
      "surface": "#1B2430",
      "raised": "#2B3748",
      "selected": "#1A3052"
    },
    "text": {
      "primary": "#F3F6FA",
      "secondary": "#B6C2D2",
      "muted": "#97A7BD",
      "inverse": "#121820",
      "link": "#96BDFF",
      "disabled": "#64748B"
    },
    "border": {
      "subtle": "#293546",
      "strong": "#64748B",
      "focus": "#96BDFF"
    },
    "action": {
      "primary": "#2563EB",
      "hover": "#1D4ED8",
      "pressed": "#1E40AF",
      "foreground": "#FFFFFF",
      "disabledBackground": "#2B3748",
      "disabledForeground": "#97A7BD"
    },
    "status": {
      "success": {
        "background": "#14382F",
        "foreground": "#7DE0B6",
        "border": "#357C63"
      },
      "warning": {
        "background": "#382C18",
        "foreground": "#F3CA7A",
        "border": "#8D7140"
      },
      "error": {
        "background": "#3D232B",
        "foreground": "#FDA4AF",
        "border": "#A55E6C"
      },
      "info": {
        "background": "#1A3052",
        "foreground": "#96BDFF",
        "border": "#547BAD"
      }
    }
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", sans-serif",
    "monoFamily": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
    "roles": {
      "display": {
        "size": 56,
        "lineHeight": 1.15,
        "weight": 600,
        "usage": "文档封面或产品介绍；小屏32"
      },
      "pageTitle": {
        "size": 32,
        "lineHeight": 1.35,
        "weight": 600,
        "usage": "页面主标题；小屏28"
      },
      "sectionTitle": {
        "size": 24,
        "lineHeight": 1.4,
        "weight": 600
      },
      "subheading": {
        "size": 18,
        "lineHeight": 1.5,
        "weight": 600
      },
      "body": {
        "size": 16,
        "lineHeight": 1.75,
        "weight": 400
      },
      "ui": {
        "size": 14,
        "lineHeight": 1.5,
        "weight": 500
      },
      "caption": {
        "size": 13,
        "lineHeight": 1.55,
        "weight": 400,
        "usage": "辅助规格与单位；关键病历信息不得降到此级"
      },
      "metric": {
        "size": 32,
        "lineHeight": 1.2,
        "weight": 500,
        "numeric": "tabular-nums lining-nums"
      }
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius": {
    "small": 4,
    "control": 8,
    "panel": 12,
    "dialog": 16,
    "pill": 999
  },
  "shadow": {
    "none": "none",
    "raised": "0 8px 24px rgb(0 0 0 / 20%)",
    "overlay": "0 20px 64px rgb(0 0 0 / 40%)"
  },
  "layout": {
    "maxContentWidth": 1280,
    "readingMaxWidth": 720,
    "sidebarWidth": 224,
    "gutter": 24,
    "mobileGutter": 16,
    "breakpoints": {
      "mobile": 640,
      "tablet": 1024
    },
    "controlHeight": 44,
    "tableRowMinHeight": 52,
    "focusRing": {
      "width": 2,
      "offset": 3
    }
  },
  "motion": {
    "feedbackMs": 120,
    "disclosureMs": 180,
    "dialogMs": 200,
    "easing": "cubic-bezier(0.23, 1, 0.32, 1)",
    "reducedMotion": "关闭位移与旋转，保留即时状态更新"
  },
  "formatting": {
    "date": "YYYY-MM-DD",
    "unknown": "未记录",
    "numericAlignment": "right",
    "unit": "separate-column",
    "precision": "保留报告原有精度，不自动补零，不混合单位",
    "abnormal": "颜色 + 箭头 + 文字；提示超出参考范围，不作诊断"
  }
}
