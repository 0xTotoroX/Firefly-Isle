# Based on official Supabase self-hosted/v0.8.1. Replace every REPLACE_ME.
# Generate ANON_KEY and SERVICE_ROLE_KEY with JWT_SECRET via upstream utils.
COMPOSE_FILE=docker-compose.yml
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
ANON_KEY=REPLACE_ME
SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
DASHBOARD_USERNAME=totoro
DASHBOARD_PASSWORD=REPLACE_ME
SECRET_KEY_BASE=REPLACE_ME
REALTIME_DB_ENC_KEY=REPLACE_ME
VAULT_ENC_KEY=REPLACE_ME
PG_META_CRYPTO_KEY=REPLACE_ME
LOGFLARE_PUBLIC_ACCESS_TOKEN=REPLACE_ME
LOGFLARE_PRIVATE_ACCESS_TOKEN=REPLACE_ME
S3_PROTOCOL_ACCESS_KEY_ID=REPLACE_ME
S3_PROTOCOL_ACCESS_KEY_SECRET=REPLACE_ME
SUPABASE_PUBLIC_URL=https://supabase.ghibli1024.com
API_EXTERNAL_URL=https://supabase.ghibli1024.com/auth/v1
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=Totoro
STUDIO_DEFAULT_PROJECT=Firefly-Isle
OPENAI_API_KEY=REPLACE_ME
SITE_URL=https://firefly.ghibli1024.com
ADDITIONAL_REDIRECT_URLS=https://firefly.ghibli1024.com/**,https://*.firefly-isle.pages.dev/**,http://localhost:*/**,http://127.0.0.1:*/**
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=MyOncode
ENABLE_ANONYMOUS_USERS=true
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
GLOBAL_S3_BUCKET=stub
REGION=stub
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=REPLACE_ME
STORAGE_TENANT_ID=stub
FUNCTIONS_VERIFY_JWT=true
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=REPLACE_ME
GOOGLE_PROJECT_NUMBER=REPLACE_ME
API_GW_HTTP_PORT=8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
IMGPROXY_AUTO_WEBP=true
PROXY_DOMAIN=your-domain.example.com
CERTBOT_EMAIL=admin@example.com
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=REPLACE_ME
# Use the original OAuth client secret; a hash or redacted value cannot exchange tokens.
GOOGLE_SECRET=REPLACE_ME
