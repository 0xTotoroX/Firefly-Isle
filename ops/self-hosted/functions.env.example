DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
DEFAULT_GEMINI_MODEL=gemini-3-flash-preview
# Keep the original encryption key when restoring existing provider-key ciphertext.
LLM_PROVIDER_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_ORIGINAL_ENCRYPTION_KEY
OCR_PROVIDER=deepseek
DEEPSEEK_OCR_MODEL=deepseek-v4-image
# PDF input requires OCR_PROVIDER=gemini and a validated GEMINI_API_KEY.
GEMINI_OCR_MODEL=gemini-3-flash-preview
