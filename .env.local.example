VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_EDGE_FUNCTION_URL=https://your-project.functions.supabase.co
VITE_SUPABASE_WECHAT_PROVIDER=custom:wechat

# Supabase Edge Function secrets/env, configured server-side rather than exposed to Vite.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OCR image pipeline: deepseek by default (deepseek-v4-image); gemini stays as the PDF-capable fallback
OCR_PROVIDER=deepseek
DEEPSEEK_OCR_MODEL=deepseek-v4-image

# Optional client error reporting. Accepts a Sentry DSN
# (https://<key>@o<org>.ingest.<region>.sentry.io/<project>) or any JSON POST endpoint.
# The DSN is a public key and safe to expose; leave unset to disable reporting.
# VITE_ERROR_REPORT_URL=
