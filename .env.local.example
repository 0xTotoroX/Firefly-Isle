VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_EDGE_FUNCTION_URL=https://your-project.functions.supabase.co
# Enable after the real Google OAuth client credentials have been validated.
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_SUPABASE_WECHAT_PROVIDER=
# Optional independent session storage; when set, legacy sessions are not imported.
VITE_SUPABASE_AUTH_STORAGE_KEY=myoncode-shanghai-auth-v1

# Supabase Edge Function secrets/env, configured server-side rather than exposed to Vite.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_OCR_MODEL=deepseek-flash

# Optional client error reporting. Accepts a Sentry DSN
# (https://<key>@o<org>.ingest.<region>.sentry.io/<project>) or any JSON POST endpoint.
# The DSN is a public key and safe to expose; leave unset to disable reporting.
# VITE_ERROR_REPORT_URL=
