VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_EDGE_FUNCTION_URL=https://your-project.functions.supabase.co
VITE_SUPABASE_WECHAT_PROVIDER=custom:wechat
VITE_DEMO_RECORD_SHARE_CODE=

# Supabase Edge Function secrets/env, configured server-side rather than exposed to Vite.
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional client error reporting endpoint (POST JSON). Leave unset to disable reporting.
# VITE_ERROR_REPORT_URL=
